{
  "mcpServers": {
    "finops-agent": {
      "command": "npx",
      "args": ["tsx", "src/mcp/server.ts"],
      "env": {},
      "disabled": true
    },
    "aws-pricing": {
      "command": "bash",
      "args": ["scripts/run-aws-pricing-mcp.sh"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false,
      "autoApprove": ["get_pricing", "get_pricing_service_codes", "get_pricing_service_attributes", "get_pricing_attribute_values"]
    },
    "aws-documentation": {
      "command": "uvx",
      "args": ["awslabs.aws-documentation-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false,
      "autoApprove": ["read_documentation", "search_documentation", "recommend"]
    }
  }
}
