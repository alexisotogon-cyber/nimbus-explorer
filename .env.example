# ─── Bedrock (chat del agente) ───────────────────────────────────────────────
# Credenciales leídas SOLO en el servidor (api/agent/route.ts).
# NUNCA se piden ni se aceptan desde el navegador.
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
BEDROCK_REGION=us-east-1

# Opcionales
# BEDROCK_SESSION_TOKEN=       # solo si usas credenciales temporales (STS)
# BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
# BEDROCK_ECONOMY_MODEL_ID=     # modelo más económico para consultas simples con IA

# ─── Atlas: control de costo, abuso y disponibilidad ─────────────────────────
# normal: IA habilitada dentro de presupuestos; emergency: solo respuestas determinísticas
ATLAS_MODE=normal

# Solo estos modelos pueden invocarse (separados por coma). Incluye aquí el
# modelo principal y el económico si configuras ambos.
# ATLAS_ALLOWED_MODEL_IDS=amazon.nova-pro-v1:0

ATLAS_MAX_INPUT_CHARACTERS=12000
ATLAS_MAX_BILLING_ROWS=50000
ATLAS_MAX_OUTPUT_TOKENS=220
ATLAS_MAX_MESSAGES_PER_AUDIT=12
ATLAS_MAX_TOOL_CALLS=1
ATLAS_MAX_HISTORY_MESSAGES=4
ATLAS_REQUEST_TIMEOUT_MS=30000
ATLAS_MAX_CONCURRENT_REQUESTS=4

# Ventana por IP: 30 solicitudes por hora
ATLAS_IP_WINDOW_MS=3600000
ATLAS_MAX_MESSAGES_PER_IP=30

# Hard stops. Al alcanzarlos, Atlas conserva las respuestas factuales de 0 tokens.
ATLAS_DAILY_TOKEN_BUDGET=100000
ATLAS_DAILY_COST_BUDGET_USD=1.50
ATLAS_MONTHLY_COST_BUDGET_USD=25

# Estimación local de costo. Ajusta estos valores a la tarifa del modelo elegido.
# Ajusta estos valores a la tarifa vigente de Nova Pro en tu región.
ATLAS_INPUT_PRICE_PER_MILLION_USD=0.8
ATLAS_OUTPUT_PRICE_PER_MILLION_USD=3.2
ATLAS_CACHE_READ_PRICE_PER_MILLION_USD=0

# Abre el circuito tras 3 fallos consecutivos durante 60 segundos.
ATLAS_CIRCUIT_BREAKER_FAILURES=3
ATLAS_CIRCUIT_BREAKER_OPEN_MS=60000

# ─── Actualización de catálogos (sólo CI/manual; nunca frontend/runtime) ─────
# GCP_BILLING_CATALOG_API_KEY=
# AZURE_CATALOG_CONCURRENCY=8
